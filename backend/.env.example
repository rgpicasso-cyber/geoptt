# ==============================================================================
# GeoPTT Backend — variáveis de ambiente (TEMPLATE)
#
# Copie para `.env` e preencha os valores reais. O `.env` NUNCA é versionado.
#   cp .env.example .env
#
# Regra de ouro: nenhum valor real neste arquivo. Nenhuma chave privada no repo.
# ==============================================================================

# --- Ambiente ----------------------------------------------------------------
# local | staging | production
ENV=local
DEBUG=false
APP_NAME="GeoPTT API"

# --- Banco de dados ----------------------------------------------------------
# Driver assíncrono obrigatório (asyncpg). Em produção use SSL e usuário restrito.
DATABASE_URL=postgresql+asyncpg://geoptt:CHANGE_ME@127.0.0.1:5432/geoptt
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# --- JWT ---------------------------------------------------------------------
# OBRIGATÓRIO: >= 32 caracteres aleatórios. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Em ENV=production o servidor recusa o valor padrão de desenvolvimento.
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_32_PLUS_CHARS_SECRET
JWT_ALGORITHM=HS256
JWT_ISSUER=geoptt
JWT_AUDIENCE=geoptt-app
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- WebSocket ---------------------------------------------------------------
WS_AUTH_TIMEOUT_SECONDS=3
WS_HEARTBEAT_TIMEOUT_SECONDS=60
WS_MAX_MESSAGE_BYTES=65536
WS_CONTROL_QUEUE_SIZE=256
WS_AUDIO_QUEUE_SIZE=16
PTT_SPEAKER_TIMEOUT_SECONDS=60

# --- Firebase Cloud Messaging ------------------------------------------------
# Em produção aponte para o JSON da service account FORA do repositório:
#   FCM_CREDENTIALS_PATH=/opt/geoptt/secrets/serviceAccountKey.json
# Em local, deixe FCM_ENABLED=false para não exigir credenciais.
FCM_ENABLED=false
FCM_CREDENTIALS_PATH=
FCM_PROJECT_ID=
FCM_WAKEUP_RATE_LIMIT_PER_MINUTE=10

# --- HTTP / CORS -------------------------------------------------------------
# Lista separada por vírgula. Vazio = CORS desabilitado (recomendado em produção
# para clientes móveis nativos).
CORS_ORIGINS=

# Prefixo de todas as rotas REST (os probes /health ficam na raiz).
API_PREFIX=/api/v1

# Confiar em X-Forwarded-For para descobrir o IP do cliente (rate limit de
# /auth/*). Deixe `false` quando a API estiver exposta diretamente: qualquer
# cliente poderia forjar o header e furar o limite por IP. Ligue apenas atrás de
# Nginx/Caddy controlado (Fase 6).
TRUST_PROXY_HEADERS=false

# --- Logs --------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_JSON=true
